seats = [0] * 10

while True:
    print("\n===== MOVIE TICKET BOOKING =====")
    print("1. View Seats")
    print("2. Book Seat")
    print("3. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        print("\nSeat Status:")
        for i in range(len(seats)):
            if seats[i] == 0:
                print("Seat", i + 1, "- Available")
            else:
                print("Seat", i + 1, "- Booked")

    elif choice == "2":
        seat_no = int(input("Enter seat number (1-10): "))

        if seat_no < 1 or seat_no > 10:
            print("Invalid seat number!")

        elif seats[seat_no - 1] == 1:
            print("Sorry, this seat is already booked.")

        else:
            seats[seat_no - 1] = 1
            print("Seat", seat_no, "booked successfully!")

    elif choice == "3":
        print("Thank you for using Movie Ticket Booking!")
        break

    else:
        print("Invalid choice! Please try again.")
